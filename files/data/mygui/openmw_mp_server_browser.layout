<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout">
    <!--
        Server Browser dialog  ~920 x 620
        Widgets consumed by ServerBrowserDialog.cpp:
            SearchBox     EditBox   - live name filter
            ColCompatibility TextBox - protocol compatibility marker
            ColName       TextBox   - "Server Name" column header
            ColPlayers    TextBox   - "Players" column header
            ColVersion    TextBox   - "Version" column header
            ColMode       TextBox   - "Mode" column header
            ColCountry    TextBox   - "CC" column header
            ServerList    MultiListBox - scrollable multi-column server rows
            StatusLabel   TextBox   - "Loading…" / "N servers" / error text
            RefreshButton Button    - re-fetch the list
            ConnectButton Button    - connect to selected row
            CancelButton  Button    - close the dialog
    -->
    <Widget type="Window" skin="MW_Window" layer="Modal"
            position="0 0 920 620" align="Center" name="_Main">
        <Property key="Visible"  value="false"/>
        <Property key="Caption"  value="Server Browser"/>
        <Property key="MinSize"  value="760 500"/>

        <!-- Search bar -->
        <Widget type="TextBox" skin="SandText"
                position="16 16 60 18" name="SearchLabel">
            <Property key="Caption" value="Filter:"/>
        </Widget>
        <Widget type="EditBox" skin="MW_TextEdit"
                position="72 14 832 22" name="SearchBox" align="Left Top HStretch">
            <Property key="NeedKey"       value="true"/>
            <Property key="MaxTextLength" value="128"/>
        </Widget>

        <!-- Header coordinates are updated with the table columns on resize. -->
        <Widget type="TextBox" skin="SandText"
                position="16 44 34 18" name="ColCompatibility">
            <Property key="Caption" value=""/>
        </Widget>
        <Widget type="TextBox" skin="SandText"
                position="52 44 302 18" name="ColName">
            <Property key="Caption" value="Server Name"/>
        </Widget>
        <Widget type="TextBox" skin="SandText"
                position="356 44 76 18" name="ColPlayers">
            <Property key="Caption" value="Players"/>
        </Widget>
        <Widget type="TextBox" skin="SandText"
                position="434 44 94 18" name="ColVersion">
            <Property key="Caption" value="Build"/>
        </Widget>
        <Widget type="TextBox" skin="SandText"
                position="530 44 96 18" name="ColMode">
            <Property key="Caption" value="Mode"/>
        </Widget>
        <Widget type="TextBox" skin="SandText"
                position="628 44 48 18" name="ColCountry">
            <Property key="Caption" value="CC"/>
        </Widget>

        <!-- Server list - fills the bulk of the dialog -->
        <Widget type="MultiListBox" skin="MW_MultiList"
                position="16 64 888 486" name="ServerList" align="Left Top HStretch VStretch">
        </Widget>

        <!-- Status bar -->
        <Widget type="TextBox" skin="SandText"
                position="16 558 640 18" name="StatusLabel" align="Left Bottom HStretch">
            <Property key="Caption" value=""/>
        </Widget>

        <!-- Action buttons - packed against the right edge with stable spacing. -->
        <Widget type="HBox" skin="" position="536 554 360 24" align="Right Bottom">
            <Property key="Spacing" value="4"/>
            <Widget type="Spacer">
                <UserString key="HStretch" value="true"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="RefreshButton">
                <Property key="Caption" value="Refresh"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="ConnectButton">
                <Property key="Caption" value="Connect"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="CancelButton">
                <Property key="Caption" value="#{Interface:Cancel}"/>
            </Widget>
        </Widget>

    </Widget>
</MyGUI>
